generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  active        Boolean          @default(true) // ẩn khi đóng cửa chi nhánh, vẫn giữ lịch sử
  /// Ngày bắt đầu tính hoà vốn (YYYY-MM-DD); null = từ ca làm việc đầu tiên của chi nhánh
  openedAt      String?
  createdAt     DateTime         @default(now())
  staff         User[]           @relation("UserBranches")
  shifts        Shift[]
  tasks         ChecklistTask[]
  checks        ChecklistCheck[]
  soldProducts  Product[]        @relation("ProductSoldAt")
  transfersFrom StockTransfer[]  @relation("TransferFrom")
  transfersTo   StockTransfer[]  @relation("TransferTo")
  expenses      Expense[]
  capital       CapitalEntry[]
  ownedProducts Product[]        @relation("ProductOwner")
  loansLent     BranchLoan[]     @relation("LoanLender")
  loansBorrowed BranchLoan[]     @relation("LoanBorrower")
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  name         String
  passwordHash String
  role         String           @default("STAFF") // ADMIN | STAFF
  /// Chi nhánh được phép làm việc; để trống = làm được ở mọi chi nhánh
  branches     Branch[]         @relation("UserBranches")
  /// Quyền của nhân viên (khoá trong src/lib/permissions.ts); admin bỏ qua, luôn toàn quyền.
  /// Mặc định = quyền nhân viên có sẵn, để tài khoản cũ giữ nguyên khi thêm cột.
  permissions  String[]         @default(["sell", "products", "repair-prices", "warranty", "timesheet"])
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  shifts       Shift[]
  checks       ChecklistCheck[]
  posts        Post[]
}

/// Một ca làm việc của một nhân viên trong một ngày tại một chi nhánh.
model Shift {
  id           Int           @id @default(autoincrement())
  date         String // YYYY-MM-DD (giờ Việt Nam)
  branchId     Int
  branch       Branch        @relation(fields: [branchId], references: [id])
  userId       Int?
  user         User?         @relation(fields: [userId], references: [id])
  staffName    String
  checkIn      String // HH:mm
  openingCash  Int // tiền nhận đầu ca
  checkOut     String? // HH:mm
  handoverCash Int? // tiền mặt bàn giao cuối ca
  closingNote  String?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([date, branchId])
}

model Transaction {
  id             Int      @id @default(autoincrement())
  shiftId        Int
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  kind           String // SALE | REPAIR
  /// Sản phẩm trong bảng giá được chọn khi bán (để đánh dấu máy có mã là đã bán, lấy giá nhập)
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  loans          BranchLoan[]
  gifts          TransactionGift[]
  price          Int
  costPrice      Int? // giá nhập tại thời điểm bán (lấy từ bảng giá), để tính lợi nhuận
  /// Tổng giá nhập quà tặng kèm (chụp lúc bán) — cộng vào giá vốn khi tính lãi (lib/profit.ts)
  giftCost       Int      @default(0)
  paymentMethod  String // CASH | TRANSFER
  bankAccount    String?
  warrantyMonths Int      @default(0) // 0-12; > 0 thì bắt buộc tên + SĐT khách
  customerName   String?
  customerPhone  String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([shiftId])
  @@index([customerPhone])
}

/// Phiếu hàng hoá: nhập từ nhà cung cấp (IMPORT) hoặc chuyển giữa chi nhánh (TRANSFER).
model StockTransfer {
  id           Int      @id @default(autoincrement())
  type         String   @default("TRANSFER") // IMPORT | TRANSFER
  date         String // YYYY-MM-DD
  productId    Int? // sản phẩm chọn từ danh sách hàng hoá
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  quantity     Int
  fromBranchId Int? // null khi nhập từ nhà cung cấp
  fromBranch   Branch?  @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   Int
  toBranch     Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  supplier     String? // nhà cung cấp (phiếu nhập)
  unitCost     Int? // giá nhập / đơn vị (phiếu nhập, chỉ admin thấy)
  staffName    String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([date])
}

/// Quà tặng kèm một giao dịch bán (giá 0 đ). Trừ số lượng sản phẩm; giá nhập tính vào giá vốn giao dịch.
model TransactionGift {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  quantity      Int         @default(1)
  costPrice     Int? // giá nhập / cái lúc tặng

  @@index([transactionId])
}

/// Mượn hàng giữa chi nhánh: quán mượn (borrower) lấy hàng của quán cho mượn (lender).
/// Đang mượn → Đã trả hàng, hoặc → Đã bán (quán mượn nợ quán cho mượn `amount` = giá nhập) → Đã thanh toán (`paidAt`).
model BranchLoan {
  id               Int          @id @default(autoincrement())
  productId        Int?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  quantity         Int          @default(1)
  lenderBranchId   Int
  lenderBranch     Branch       @relation("LoanLender", fields: [lenderBranchId], references: [id])
  borrowerBranchId Int
  borrowerBranch   Branch       @relation("LoanBorrower", fields: [borrowerBranchId], references: [id])
  date             String // ngày mượn YYYY-MM-DD
  status           String       @default("BORROWED") // BORROWED | RETURNED | SOLD
  /// Số tiền quán mượn phải trả khi đã bán = giá nhập × SL (admin sửa được). Chỉ admin thấy
  amount           Int          @default(0)
  transactionId    Int? // giao dịch bán (tự gắn khi bán qua trang Bán hàng)
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  soldDate         String? // ngày bán YYYY-MM-DD
  returnedDate     String? // ngày trả hàng
  paidAt           DateTime? // đã thanh toán cho quán cho mượn
  paidBy           String?
  note             String?
  createdBy        String
  createdAt        DateTime     @default(now())

  @@index([status])
  @@index([productId])
}

/// Người góp vốn (có thể không phải nhân viên nên không dùng bảng User).
model Investor {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String?
  note      String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  entries   CapitalEntry[]
}

/// Sổ vốn: mỗi lần một người góp vốn vào / rút tiền ra khỏi một chi nhánh.
/// Vốn đầu tư của chi nhánh = tổng tiền góp (CONTRIBUTE); rút (WITHDRAW) không phải chi phí nên không trừ vào lãi.
model CapitalEntry {
  id         Int      @id @default(autoincrement())
  investorId Int
  investor   Investor @relation(fields: [investorId], references: [id])
  branchId   Int
  branch     Branch   @relation(fields: [branchId], references: [id])
  type       String // CONTRIBUTE (góp) | WITHDRAW (rút)
  date       String // YYYY-MM-DD
  amount     Int
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([investorId])
  @@index([branchId])
}

/// Chi phí vận hành (mặt bằng, lương, điện nước...) — trừ vào lãi gộp để ra lãi ròng ở trang Báo cáo.
model Expense {
  id        Int      @id @default(autoincrement())
  date      String // YYYY-MM-DD (giờ Việt Nam) — báo cáo tính theo tháng của ngày này
  branchId  Int? // null = chi phí chung cả cửa hàng
  branch    Branch?  @relation(fields: [branchId], references: [id])
  category  String // khoá trong EXPENSE_CATEGORIES (src/lib/expenses.ts)
  amount    Int
  note      String?
  createdBy String // tên người nhập
  createdAt DateTime @default(now())

  @@index([date])
}

/// Bảng giá điện thoại / phụ kiện để nhân viên tra cứu khi bán.
model Product {
  id             Int             @id @default(autoincrement())
  category       String // IPHONE | ANDROID | ACCESSORY
  name           String // VD: iPhone 13 Pro Max
  brandId        Int? // thương hiệu (phụ kiện, Android)
  brand          Brand?          @relation(fields: [brandId], references: [id])
  variant        String? // VD: 128GB - Xanh
  ramGb          Int? // điện thoại: RAM (GB)
  storageGb      Int? // điện thoại: bộ nhớ trong (GB), 1TB = 1024
  condition      String          @default("NEW") // NEW | USED (máy cũ / 99%)
  /// Số lượng còn: máy có IMEI luôn 1 (theo dõi bằng Đang bán / Đã bán); hàng khác trừ khi bán / tặng, cộng khi nhập.
  /// Có thể âm khi số liệu chưa khớp (để không chặn bán hàng)
  quantity       Int             @default(1)
  price          Int
  costPrice      Int? // giá nhập (chỉ admin thấy) để tính lợi nhuận
  warrantyMonths Int             @default(0) // bảo hành mặc định khi bán
  code           String? // mã sản phẩm: IMEI (máy) hoặc mã vạch / mã riêng (phụ kiện)
  batteryHealth  Int? // chỉ iPhone: tình trạng pin %, vd 88
  /// Đã bán: chi nhánh bán + thời điểm (null = chưa bán). Điện thoại có mã tự đánh dấu khi bán qua giao dịch.
  soldBranchId   Int?
  soldBranch     Branch?         @relation("ProductSoldAt", fields: [soldBranchId], references: [id])
  soldAt         DateTime?
  /// Chi nhánh quản lý hàng này (mỗi quán có nguồn hàng riêng). Quán khác bán / tặng → tự ghi sổ Mượn hàng (BranchLoan)
  ownerBranchId  Int?
  ownerBranch    Branch?         @relation("ProductOwner", fields: [ownerBranchId], references: [id])
  loans          BranchLoan[]
  gifts          TransactionGift[]
  transactions   Transaction[]
  stockTransfers StockTransfer[]
  note           String? // tình trạng, pin, bảo hành...
  /// --- Hiển thị trên web marketing (API công khai /api/public) ---
  showOnWeb      Boolean         @default(false) // chỉ sản phẩm bật cờ này mới xuất hiện trên web
  slug           String? // đường dẫn web, tự tạo từ tên nếu để trống (không trùng — kiểm tra trong code)
  description    String? // mô tả cho web
  salePrice      Int? // giá khuyến mãi (nhỏ hơn giá bán)
  priceOnRequest Boolean         @default(false) // web hiện "Liên hệ" thay giá (giá vẫn dùng nội bộ khi bán)
  featured       Boolean         @default(false) // nổi bật trên web
  sortOrder      Int             @default(0) // số nhỏ hiện trước
  imageUrls      String[]        @default([]) // link ảnh, ảnh đầu là ảnh đại diện
  active         Boolean         @default(true) // còn bán
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())

  @@index([category])
  @@index([slug])
  @@index([showOnWeb])
}

/// Bảng giá sửa chữa: thay pin, thay màn hình, ép kính...
model RepairPrice {
  id        Int      @id @default(autoincrement())
  service   String // VD: Thay pin
  device    String // VD: iPhone 11
  price     Int // 0 = chưa có giá cố định, web hiện "Liên hệ"
  warranty  String? // VD: 6 tháng
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([service])
}

/// Việc cần làm hằng ngày do admin thiết lập (vệ sinh quán, đăng bài FB...).
model ChecklistTask {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  branchId    Int? // null = áp dụng mọi chi nhánh
  branch      Branch?          @relation(fields: [branchId], references: [id])
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  checks      ChecklistCheck[]
}

/// Đánh dấu một việc đã làm trong một ngày tại một chi nhánh.
model ChecklistCheck {
  id       Int           @id @default(autoincrement())
  taskId   Int
  task     ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD
  branchId Int
  branch   Branch        @relation(fields: [branchId], references: [id])
  userId   Int
  user     User          @relation(fields: [userId], references: [id])
  doneAt   DateTime      @default(now())

  @@unique([taskId, date, branchId])
  @@index([date, branchId])
}

/// Đánh dấu việc của chủ quán đã làm (danh sách việc cố định trong src/lib/admin-tasks.ts).
model AdminCheck {
  id       Int      @id @default(autoincrement())
  taskKey  String // key trong ADMIN_TASKS
  period   String // ngày YYYY-MM-DD | tuần W:YYYY-MM-DD (thứ Hai) | tháng YYYY-MM
  userName String // ai tick — lưu tên để không phải nối bảng User
  doneAt   DateTime @default(now())

  @@unique([taskKey, period])
}

/// Thương hiệu sản phẩm (Samsung, Anker, Baseus...) — admin quản lý, chọn khi nhập phụ kiện / Android.
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

/// Bài viết tin tức cho web marketing (API công khai /api/public/posts).
model Post {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String // không trùng — kiểm tra trong code
  category      String    @default("NEWS") // NEWS | PROMOTION | GUIDE
  excerpt       String? // tóm tắt ngắn hiện ở danh sách
  content       String    @default("") // Markdown
  coverImageUrl String?
  status        String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt   DateTime? // ngày đăng; > hiện tại = hẹn giờ
  featured      Boolean   @default(false)
  authorId      Int?
  author        User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
}
