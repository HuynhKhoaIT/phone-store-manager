# Postgres (trên Vercel: dùng Neon, biến này được tự thêm khi gắn database)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập, vd: openssl rand -base64 32
AUTH_SECRET=""
# (Tuỳ chọn) Domain web bán hàng được gọi /api/public, cách nhau dấu phẩy. Để trống = mọi domain
PUBLIC_API_ORIGINS=""
